//! \brief return an elastic prediction of the stresses
StressStensor computeElasticPrediction() const{
StressStensor prediction_stress;
StrainStensor prediction_strain = this->eel+(this->theta)*this->deto;
prediction_stress(0) = 2*(this->mu)*((this->lambda)/(this->lambda+2*(this->mu))*(prediction_strain(0)+prediction_strain(2))+prediction_strain(0))+
(this->lambda)/(this->lambda+2*(this->mu))*(this->sigzz+(this->theta)*(this->dsigzz));
